{
  "title": "coded-ballot rules file",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "election": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "organisation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "timezone": {
          "default": "UTC",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title",
        "organisation"
      ]
    },
    "dates": {
      "type": "object",
      "properties": {
        "notice": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "description": "the roll (including emails) is frozen at this time"
        },
        "ballots_out": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "voting_opens": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "voting_closes": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "meeting": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "notice",
        "ballots_out",
        "voting_opens",
        "voting_closes"
      ]
    },
    "retention_days": {
      "default": 90,
      "description": "days after certification before purge",
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "roles": {
      "default": {
        "mode": "separated"
      },
      "type": "object",
      "properties": {
        "mode": {
          "default": "separated",
          "type": "string",
          "enum": [
            "separated",
            "one_person"
          ]
        }
      }
    },
    "channels": {
      "default": {
        "mail": true,
        "online": true,
        "in_person": true
      },
      "type": "object",
      "properties": {
        "mail": {
          "default": true,
          "type": "boolean"
        },
        "online": {
          "default": true,
          "type": "boolean"
        },
        "in_person": {
          "default": true,
          "type": "boolean"
        }
      }
    },
    "time_lock": {
      "default": {
        "enabled": false
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        }
      }
    },
    "classes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "weight": {
            "default": 1,
            "description": "a fixed weight for everyone in the class, or a roll column",
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "pattern": "^\\d+(\\.\\d{1,4})?$"
                  }
                ]
              },
              {
                "type": "object",
                "properties": {
                  "column": {
                    "type": "string",
                    "minLength": 1,
                    "description": "roll CSV column holding each member’s units or shares"
                  }
                },
                "required": [
                  "column"
                ]
              }
            ]
          }
        },
        "required": [
          "id",
          "label"
        ]
      }
    },
    "contests": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "eligible_classes": {
                "description": "membership classes that vote on this; default all",
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                }
              },
              "weighted": {
                "default": false,
                "description": "use each member's class weight (units or shares) for this contest",
                "type": "boolean"
              },
              "candidates": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "note": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ]
                }
              },
              "seats": {
                "default": 1,
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "write_ins": {
                "default": false,
                "type": "boolean"
              },
              "method": {
                "type": "string",
                "const": "plurality"
              }
            },
            "required": [
              "id",
              "title",
              "candidates",
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "eligible_classes": {
                "description": "membership classes that vote on this; default all",
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                }
              },
              "weighted": {
                "default": false,
                "description": "use each member's class weight (units or shares) for this contest",
                "type": "boolean"
              },
              "candidates": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "note": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ]
                }
              },
              "seats": {
                "default": 1,
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "write_ins": {
                "default": false,
                "type": "boolean"
              },
              "method": {
                "type": "string",
                "const": "approval"
              },
              "max_approvals": {
                "description": "most choices one ballot may mark; default no limit",
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "title",
              "candidates",
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "eligible_classes": {
                "description": "membership classes that vote on this; default all",
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                }
              },
              "weighted": {
                "default": false,
                "description": "use each member's class weight (units or shares) for this contest",
                "type": "boolean"
              },
              "candidates": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "note": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ]
                }
              },
              "seats": {
                "default": 1,
                "type": "number",
                "const": 1
              },
              "write_ins": {
                "default": false,
                "type": "boolean"
              },
              "method": {
                "type": "string",
                "const": "irv"
              }
            },
            "required": [
              "id",
              "title",
              "candidates",
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "eligible_classes": {
                "description": "membership classes that vote on this; default all",
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                }
              },
              "weighted": {
                "default": false,
                "description": "use each member's class weight (units or shares) for this contest",
                "type": "boolean"
              },
              "candidates": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "note": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ]
                }
              },
              "seats": {
                "default": 1,
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "write_ins": {
                "default": false,
                "type": "boolean"
              },
              "method": {
                "type": "string",
                "const": "stv"
              },
              "stv_rules": {
                "default": "scottish",
                "description": "Scottish STV (SSI 2007/42 rules 45-52)",
                "type": "string",
                "const": "scottish"
              }
            },
            "required": [
              "id",
              "title",
              "candidates",
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "eligible_classes": {
                "description": "membership classes that vote on this; default all",
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                }
              },
              "weighted": {
                "default": false,
                "description": "use each member's class weight (units or shares) for this contest",
                "type": "boolean"
              },
              "method": {
                "type": "string",
                "const": "yes_no"
              },
              "threshold": {
                "default": {
                  "fraction": "1/2",
                  "of": "votes_cast",
                  "rule": "more_than",
                  "abstain_counts": false
                },
                "type": "object",
                "properties": {
                  "fraction": {
                    "type": "string",
                    "pattern": "^\\d+\\/\\d+$",
                    "description": "share of the base needed, e.g. 1/2 or 2/3"
                  },
                  "of": {
                    "default": "votes_cast",
                    "description": "votes_cast: yes + no (abstentions left out unless abstain_counts); members: every eligible member",
                    "type": "string",
                    "enum": [
                      "votes_cast",
                      "members"
                    ]
                  },
                  "rule": {
                    "default": "more_than",
                    "description": "more_than 1/2 is a simple majority; at_least 2/3 is the usual two-thirds",
                    "type": "string",
                    "enum": [
                      "more_than",
                      "at_least"
                    ]
                  },
                  "abstain_counts": {
                    "default": false,
                    "description": "count abstentions in votes_cast",
                    "type": "boolean"
                  }
                },
                "required": [
                  "fraction"
                ]
              },
              "allow_abstain": {
                "default": true,
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "title",
              "method"
            ]
          }
        ]
      }
    },
    "quorum": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "ballots": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "ballots"
          ]
        },
        {
          "type": "object",
          "properties": {
            "fraction_of_members": {
              "type": "string",
              "pattern": "^\\d+\\/\\d+$"
            }
          },
          "required": [
            "fraction_of_members"
          ]
        }
      ],
      "description": "minimum turnout for any result to stand"
    },
    "tie_break": {
      "default": [
        "previous_rounds",
        "lot"
      ],
      "description": "how ties are settled, in order; lot uses the first drand round after close",
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "previous_rounds",
          "lot"
        ]
      }
    },
    "small_group_threshold": {
      "default": 5,
      "type": "integer",
      "minimum": 2,
      "maximum": 9007199254740991
    },
    "large_print": {
      "default": true,
      "description": "offer a large-print ballot style",
      "type": "boolean"
    },
    "notice_wording": {
      "default": {
        "report_misuse": "If the tracker shows your code as used and you did not use it, tell the tellers at once."
      },
      "type": "object",
      "properties": {
        "intro": {
          "type": "string",
          "maxLength": 4000
        },
        "report_misuse": {
          "default": "If the tracker shows your code as used and you did not use it, tell the tellers at once.",
          "type": "string",
          "maxLength": 1000
        }
      }
    }
  },
  "required": [
    "schema_version",
    "election",
    "dates",
    "classes",
    "contests"
  ]
}
