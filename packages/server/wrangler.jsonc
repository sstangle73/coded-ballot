// Cloudflare Workers target. Copy this file, set your own names and IDs, then:
//   npx wrangler d1 create coded-ballot          (put the database_id below)
//   npx wrangler r2 bucket create coded-ballot-images
//   npx wrangler d1 migrations apply coded-ballot --remote
//   npx wrangler secret put SES_KEY_ID             (and SES_SECRET, for mail)
//   npx wrangler deploy
//   npm run setup-link -w @coded-ballot/server -- -c packages/server/wrangler.jsonc   (prints the first person's link)
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "coded-ballot",
  "main": "src/targets/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "../web/dist", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "coded-ballot", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "coded-ballot-images" }],
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "PUBLIC_ORIGIN": "https://coded-ballot.example.workers.dev",
    "RP_NAME": "coded-ballot",
    "PROJECT_ORIGINS": "",
    "MAIL_FROM": "",
    "SES_REGION": "us-east-1"
  }
}
