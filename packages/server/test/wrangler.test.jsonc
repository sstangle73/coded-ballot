// Local-only config for the Workers test: no assets, local D1 and R2.
{
  "name": "coded-ballot-test",
  "main": "../src/targets/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "coded-ballot-test", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../migrations" }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "coded-ballot-test" }]
}
