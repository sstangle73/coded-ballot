{
  "name": "@coded-ballot/server",
  "version": "0.1.0",
  "description": "coded-ballot server: one Hono app for Cloudflare Workers (D1, R2) and Node (SQLite, local disk)",
  "license": "AGPL-3.0-only",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
